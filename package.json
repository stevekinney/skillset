{
  "name": "@lostgradient/skillset",
  "version": "0.1.0",
  "description": "Zod schemas, type guards, and validators for Claude Code and OpenAI Codex: skill and subagent frontmatter, MCP servers, hooks and hook payloads, session transcripts, and workflow scripts.",
  "homepage": "https://github.com/stevekinney/skillset#readme",
  "bugs": "https://github.com/stevekinney/skillset/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/skillset.git"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/bun/index.js",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./workflow-globals": {
      "types": "./dist/claude-workflow-globals.d.ts",
      "bun": "./dist/bun/claude-workflow-globals.js",
      "import": "./dist/node/claude-workflow-globals.js",
      "default": "./dist/node/claude-workflow-globals.js"
    },
    "./hooks": {
      "types": "./dist/entry-hooks.d.ts",
      "bun": "./dist/bun/entry-hooks.js",
      "import": "./dist/node/entry-hooks.js",
      "default": "./dist/node/entry-hooks.js"
    },
    "./sessions": {
      "types": "./dist/entry-sessions.d.ts",
      "bun": "./dist/bun/entry-sessions.js",
      "import": "./dist/node/entry-sessions.js",
      "default": "./dist/node/entry-sessions.js"
    },
    "./workflows": {
      "types": "./dist/entry-workflows.d.ts",
      "bun": "./dist/bun/entry-workflows.js",
      "import": "./dist/node/entry-workflows.js",
      "default": "./dist/node/entry-workflows.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "workflow-globals": [
        "./dist/claude-workflow-globals.d.ts"
      ],
      "hooks": [
        "./dist/entry-hooks.d.ts"
      ],
      "sessions": [
        "./dist/entry-sessions.d.ts"
      ],
      "workflows": [
        "./dist/entry-workflows.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "check:claude-sessions": "bun run scripts/check-claude-session-schema.ts",
    "check:codex-sessions": "bun run scripts/check-codex-session-schema.ts",
    "check:workflows": "bun run scripts/check-workflow-schema.ts",
    "clean": "rm -rf dist coverage node_modules/.cache/tsconfig.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "prepack": "bun run build",
    "package:check": "bun run scripts/check-package.ts",
    "preflight:publish": "bun run scripts/preflight-publish.ts",
    "prepare": "bun x lefthook install",
    "prepublishOnly": "bun run preflight:publish && bun run validate",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:test && bun run test && bun run build && bun run package:check && bun run verify:package-types",
    "verify:package-types": "bun run scripts/verify-package-types.ts",
    "verify:release-version": "bun run scripts/verify-release-version.ts"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "chalk": "^6.0.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "sort-package-json": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
