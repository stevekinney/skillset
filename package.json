{
  "name": "@lostgradient/skillset",
  "version": "0.0.3",
  "description": "Compile one canonical set of agent skills, subagents, MCP servers, instructions, hooks, and model defaults into Claude Code and OpenAI Codex configuration.",
  "homepage": "https://github.com/stevekinney/skillset#readme",
  "bugs": "https://github.com/stevekinney/skillset/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/skillset.git"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/bun/index.js",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skillset": "dist/node/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "clean": "rm -rf dist coverage node_modules/.cache/tsconfig.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "dev": "bun --watch run src/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "prepack": "bun run build",
    "package:check": "bun run scripts/check-package.ts",
    "preflight:publish": "bun run scripts/preflight-publish.ts",
    "prepare": "bun x lefthook install",
    "prepublishOnly": "bun run preflight:publish && bun run validate",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:test && bun run test && bun run build && bun run package:check",
    "verify:release-version": "bun run scripts/verify-release-version.ts"
  },
  "dependencies": {
    "@lostgradient/environmentalist": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "sort-package-json": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
